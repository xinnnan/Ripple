# =====================================================================
# Ripple — env template
# =====================================================================
# Copy to .env.local and fill in real values. .env.local is gitignored.
# Required for a working dev / e2e environment:
#   1. Supabase project (URL + new-format keys, see below)
#   2. Slack app (bot token + signing secret)
# Optional (system tolerates missing values, falls back gracefully):
#   3. AI provider key (mock fallback if blank/invalid)
#   4. Resend API key (email send silently skipped if blank)
# =====================================================================

# ---- Supabase --------------------------------------------------------
# New key format: sb_publishable_ (anon) + sb_secret_ (service role).
# Legacy SERVICE_ROLE_KEY / ANON_KEY envs are no longer used.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here

# ---- Slack -----------------------------------------------------------
# Bot User OAuth Token (xoxb-…) + Signing Secret from the Slack app config.
# Both are required for readiness. Slack ingress returns fail-closed 503 when
# either value is absent/placeholder; there is no development auth bypass.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# ---- AI (Ripple Assist) ----------------------------------------------
# Provider: MiniMax AI (OpenAI-compatible).
# Leave MINIMAX_API_KEY blank to use the mock fallback (Sprint 2
# behavior). The /api/ai/suggest endpoint will return a structured
# mock response with confidence_level: "low" and metadata._mock: true.
MINIMAX_API_KEY=your-minimax-api-key-here
MINIMAX_BASE_URL=https://api.minimax.chat/v1/
MINIMAX_MODEL=M2.7-highspeed

# ---- Email (Resend) --------------------------------------------------
# Used by durable ticket-created and ticket-resolved outbox delivery.
# Leave RESEND_API_KEY blank to disable email without failing readiness. Once a
# key is set, readiness requires a non-placeholder re_ key, a plain valid
# EMAIL_FROM address, and NEXT_PUBLIC_APP_URL. Production links require a
# public HTTPS root origin; localhost HTTP is accepted only outside production.
RESEND_API_KEY=re_your-resend-key
EMAIL_FROM=support@dropletai.services

# ---- App -------------------------------------------------------------
# Development example only. Set the deployed public HTTPS root origin in
# production (for example https://support.dropletai.services, with no path,
# query, fragment, or embedded credentials).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Durable outbox worker -------------------------------------------
# Long random bearer token used by Vercel Cron when it calls the internal
# outbox dispatcher. Generate at least 32 random bytes; never expose it to
# browser code or commit the real value.
CRON_SECRET=replace-with-a-long-random-secret

# ---- Credentialed E2E (optional, never commit the fixture) -----------
# Absolute path to a local JSON fixture matching:
# scripts/credentialed-role-matrix.example.json
# When unset, npm run test:e2e prints an explicit credentialed-suite skip.
# In a protected CI/staging gate, also set RIPPLE_E2E_REQUIRE_CREDENTIALS=1
# so a missing fixture fails rather than skips.
RIPPLE_E2E_FIXTURES_FILE=
RIPPLE_E2E_REQUIRE_CREDENTIALS=0
